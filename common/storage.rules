rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public JPG uploads. The client-side password does not protect Storage.
    function jpgUpload() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    match /players/{filename} {
      allow read: if true;
      allow write: if jpgUpload();
    }
    match /photos/{filename} {
      allow read: if true;
      allow write: if request.resource.size <= 250000
        && request.resource.contentType == 'image/jpeg';
    }
    match /site/hero.jpg {
      allow read: if true;
      allow write: if jpgUpload();
    }
  }
}
